# =============================================================================
# CRM Monorepo — Environment Variables
# Copy this file to .env and adjust values for your local machine:
#   cp .env.example .env
# =============================================================================

# --- API (FastAPI) ---
# Host binding inside the API container (keep 0.0.0.0 for Docker)
API_HOST=0.0.0.0
# Port exposed on your machine for the CRM API (health: GET http://localhost:8000/health)
API_PORT=8000
# Environment label (development | staging | production)
API_ENV=development

# --- PostgreSQL ---
# Database service hostname (use "db" when running via Docker Compose)
POSTGRES_HOST=db
# Port exposed on your machine for PostgreSQL
POSTGRES_PORT=5432
# Database credentials — development placeholders only, not for production
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm

# --- Web (Angular) ---
# Port exposed on your machine for the Angular dev server
WEB_PORT=4200
# Public URL of the frontend (used in documentation and CORS configuration)
WEB_URL=http://localhost:4200

# --- CORS ---
# Comma-separated list of allowed origins for the CRM API
CORS_ORIGINS=http://localhost:4200

# --- Compose project name (optional) ---
COMPOSE_PROJECT_NAME=crm-monorepo

# --- Q2 Helix (middleware-only; never expose to the browser) ---
# Sandbox: https://sandbox-api.helix.q2.com
# Production: https://api.helix.q2.com
# Auth: HTTP Basic — username=API Key, password=API Secret
# Production requires IP whitelisting (sandbox whitelist may differ).
Q2_HELIX_API_URL=https://sandbox-api.helix.q2.com
Q2_HELIX_API_KEY=
Q2_HELIX_API_SECRET=
Q2_HELIX_PROGRAM_ID=
Q2_ENVIRONMENT=sandbox
# Required for account create during local→Helix provisioning
Q2_HELIX_DEFAULT_PRODUCT_ID=
# Optional display name template for provisioned accounts ({full_name}, {tag})
Q2_HELIX_ACCOUNT_NAME_TEMPLATE={full_name} Account
# Optional DB URL override for local customer persistence (defaults to SQLite file under ./data)
# Q2_DATABASE_URL=postgresql+psycopg://crm:crm_dev_password@localhost:5432/crm
