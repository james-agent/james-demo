# =============================================================================
# CRM Monorepo — Environment Variables
# Copy this file to .env and adjust values for your local machine:
#   cp .env.example .env
# =============================================================================

# --- API (FastAPI) ---
# Host binding inside the API container (keep 0.0.0.0 for Docker)
API_HOST=0.0.0.0
# Port exposed on your machine for the CRM API (health: GET http://localhost:8000/health)
API_PORT=8000
# Environment label (development | staging | production)
API_ENV=development

# --- PostgreSQL ---
# Database service hostname (use "db" when running via Docker Compose)
POSTGRES_HOST=db
# Port exposed on your machine for PostgreSQL
POSTGRES_PORT=5432
# Database credentials — development placeholders only, not for production
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
# Optional override for SQLAlchemy/Alembic (defaults to POSTGRES_* above)
# DATABASE_URL=postgresql://crm:crm_dev_password@db:5432/crm

# --- Web (Angular) ---
# Port exposed on your machine for the Angular dev server
WEB_PORT=4200
# Public URL of the frontend (used in documentation and CORS configuration)
WEB_URL=http://localhost:4200

# --- CORS ---
# Comma-separated list of allowed origins for the CRM API
CORS_ORIGINS=http://localhost:4200

# --- Compose project name (optional) ---
COMPOSE_PROJECT_NAME=crm-monorepo

# --- Q2 Helix Integration ---
# Sandbox base URL (production: https://api.helix.q2.com)
Q2_HELIX_API_URL=https://sandbox-api.helix.q2.com
# HTTP Basic Auth credentials from Helix Admin
Q2_HELIX_API_KEY=
Q2_HELIX_API_SECRET=
# Program identifier for /program/get and customer onboarding
Q2_HELIX_PROGRAM_ID=
# sandbox | production
Q2_ENVIRONMENT=sandbox
